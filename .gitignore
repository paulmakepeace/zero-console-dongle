firmware/secrets.yaml
firmware/.esphome/

# Bike log captures. Console dumps are plain text (picocom --logfile, PuTTY
# session logs); the Zero app exports binary .bin; the parsers write
# .txt/.csv/.tsv/.json/.html beside them. Captures can carry serial numbers.
logs/*
!logs/.gitkeep
*.bin
*.log
*.txt
*.csv
*.tsv

# PlatformIO build output
firmware/.pio/
firmware/managed_components/
firmware/.dummy/
firmware/sdkconfig.*
firmware/dependencies.lock

# Private identifier patterns for tools/check-private.sh: the VIN and serials live here, never in a tracked file.
.private-patterns

# The bench's fake MBB answers are the bike's own outputs, scrubbed and gated;
# the bench needs them, so they are tracked despite the rule above.
!tools/mbb-answers/*.txt
